# =============================================================================
# UNITE — ENVIRONMENT CONFIGURATION
# =============================================================================

# --- Server ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CLIENT_ORIGIN=http://localhost:5173

# --- Database (Supabase PostgreSQL) ---
# Production: PostgreSQL connection string from Supabase Project Settings -> Database
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres?sslmode=require
# Local dev without an external Postgres instance:
# Set STORAGE_DRIVER=pglite to run embedded PostgreSQL persisted in .unite-data/pgdata
STORAGE_DRIVER=pglite

# --- Authentication (Supabase Auth) ---
# Set AUTH_PROVIDER=supabase in production and provide your Supabase keys.
# Set AUTH_PROVIDER=local for local/CI development without an external Supabase project.
AUTH_PROVIDER=local
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Used when AUTH_PROVIDER=local (minimum 32 chars in production)
LOCAL_JWT_SECRET=unite-local-dev-jwt-secret-change-in-production-32chars

# --- Hosted Code Execution (C / C++ / Java / Go / Rust / PHP) ---
# Server-side proxy target (never exposed to browser).
# Compatible with Piston v2 API (e.g. https://emkc.org/api/v2/piston/execute or self-hosted Piston).
EXECUTION_PROVIDER=piston
EXECUTION_API_URL=https://emkc.org/api/v2/piston/execute
EXECUTION_API_KEY=
EXECUTION_TIMEOUT_MS=10000
EXECUTION_MAX_OUTPUT_BYTES=65536

# --- Optional Remote Terminal Gateway ---
# Browser terminal uses WebContainers natively for JS/Node.
# Leave empty unless connecting a dedicated remote sandbox terminal service.
TERMINAL_GATEWAY_URL=

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:4000
VITE_COLLAB_WS_URL=ws://localhost:4000/collab
VITE_EVENTS_WS_URL=ws://localhost:4000/ws/events
VITE_TERMINAL_WS_URL=ws://localhost:4000/ws/terminal
VITE_AUTH_MODE=local
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

